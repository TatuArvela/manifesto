{
  "name": "manifesto",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "author": "Tatu Arvela",
  "repository": {
    "type": "git",
    "url": "https://github.com/TatuArvela/manifesto.git"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@hono/node-ws>@hono/node-server": "2"
      }
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "biome check --error-on-warnings . && pnpm lint:dashes",
    "lint:dashes": "! git grep --untracked -nIP '\\x{2014}' -- ':!CLAUDE.md'",
    "lint:fix": "biome check --write .",
    "prepare": "node -e \"try { require('node:child_process').execFileSync('git', ['config', '--local', 'core.hooksPath', '.githooks'], { stdio: 'ignore' }) } catch {}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @manifesto/shared build && pnpm -r test"
  }
}
