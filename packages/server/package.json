{
  "name": "@manifesto/server",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "author": "Tatu Arvela",
  "type": "module",
  "imports": {
    "#/*.ts": {
      "manifesto-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=manifesto-source src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsx ../build-version/src/cli.ts > dist/VERSION",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.8.0",
    "@hono/node-server": "^2.1.8",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@manifesto/shared": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.0",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@hocuspocus/provider": "^4.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
