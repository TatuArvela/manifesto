# Branding. All of it is optional; see the "Rebranding" section of
# docs/specification/client/deployment.md, which also covers doing this to a
# prebuilt release bundle without rebuilding.

# The product name shown to users: window title, PWA manifest, header, login
# screen, download filenames, and every translated string that mentions the app.
#
# VITE_APP_NAME=Corporate Notes

# The app's mark (header, sign-in screen, welcome dialog): an image file,
# published beside index.html as app-logo.<ext>. It is inverted in dark mode,
# so a dark single-colour shape works best. Default: the Manifesto logo.
#
# VITE_APP_LOGO=../acme-brand/notes-mark.svg

# Whose copy this is, all optional. The instance name tells copies of the app
# apart (header, window title, sign-in screen, authenticator entry); the
# organisation that owns the instance appears by name, with its logo, on the
# sign-in screen and in About. The logo is drawn as it is, never inverted.
#
# VITE_INSTANCE_NAME=Foo QA project
# VITE_ORG_NAME=Acme Inc
# VITE_ORG_LOGO=../acme-brand/acme.svg

# One-line description, used in the PWA manifest and the HTML meta description.
#
# VITE_APP_DESCRIPTION=Shared notes for the Acme team.

# A folder of replacement brand marks, overlaid onto the build output. Any of
# favicon.svg, icon-1024.png and logo.svg (the header mark) that it contains
# wins over the stock one; the rest are left alone. Keeping them outside the
# repository means upstream updates never conflict with your icons.
#
# VITE_APP_ICONS_DIR=../acme-brand

# The welcome dialog a first-time visitor sees, which says what the app is and
# where their notes are saved (this browser, or the server and account). On by
# default; set to "off" to skip it.
#
# VITE_APP_WELCOME=off

# When set, the client switches from local-only mode to server-backed mode:
# users must log in, notes sync via the Manifesto server. Leave unset to keep
# the default offline-first behaviour using localStorage.
#
# VITE_MANIFESTO_SERVER=http://localhost:3001
