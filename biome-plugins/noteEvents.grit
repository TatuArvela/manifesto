language js

// .claude/rules/sharing.md: each participant sees different
// personal fields and a different sharing.role, so the writer's copy of a
// note must never be broadcast as it is.
`{ type: "note:updated", $props }` as $event where {
  register_diagnostic(
    span=$event,
    message="Broadcast note updates through sharing/noteEvents.ts: each participant sees their own copy of the note."
  )
}
