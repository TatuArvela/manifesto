language js

// .claude/rules/sharing.md: each participant sees different personal fields and
// a different sharing.role, and the arrival, change or loss of a note must
// reach each of them (and their webhooks) in the same way. Thus, each note and
// invitation event is built in sharing/noteEvents.ts and in no other place.
`{ type: $type, $props }` as $event where {
  $type <: or {
    `"note:created"`,
    `"note:updated"`,
    `"note:deleted"`,
    `"invitation:created"`,
    `"invitation:removed"`
  },
  register_diagnostic(
    span=$event,
    message="Announce note and invitation events through sharing/noteEvents.ts: each participant hears their own copy."
  )
}
