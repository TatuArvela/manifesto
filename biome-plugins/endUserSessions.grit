language js

// .claude/rules/accounts.md: sockets authenticate one time, when they connect.
// Thus, a deletion of the session rows of a user leaves their sockets live.
`$storage.sessions.deleteByUser($args)` where {
  register_diagnostic(
    span=$storage,
    message="End a user's sessions through endUserSessions (auth/session.ts): deleting the rows alone leaves their sockets open."
  )
}
